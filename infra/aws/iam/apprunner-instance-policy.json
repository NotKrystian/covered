{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReceiptsBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::covered-hack-616532055961/*"
    },
    {
      "Sid": "ReceiptsBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::covered-hack-616532055961"
    },
    {
      "Sid": "MemoryTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-2:616532055961:table/covered-memory"
    },
    {
      "Sid": "BedrockJudge",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*"
    }
  ]
}
