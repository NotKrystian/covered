# Copy to .env.local and fill in. Never commit real values.
AWS_REGION=eu-west-2
AWS_PROFILE=default
S3_BUCKET=covered-hack-616532055961
NEXT_PUBLIC_APP_NAME=Covered
# Unpacked Covered reader extension id (see extension/README.md). Paste once after Load unpacked if yours differs.
NEXT_PUBLIC_COVERED_EXTENSION_ID=hlllnaaelmdioofigcmnafmiimafhglf
# Bedrock judge (Judge+Memory). Vision-capable EU cross-region inference profile.
# Default eu.anthropic.claude-haiku-4-5-20251001-v1:0 ($1/$5 per 1M tokens). Budget alternative: amazon.nova-lite-v1:0.
BEDROCK_MODEL_ID=
# Region for Bedrock and DynamoDB. Falls back to AWS_REGION, then eu-west-2.
BEDROCK_REGION=
# Set to 1 to force the deterministic mock judge and template summaries (no Bedrock calls).
COVERED_MOCK=
# Judge batches (6 listings each) sent to Bedrock at once. Empty = 4; 1 = one after another.
JUDGE_CONCURRENCY=
# DynamoDB table for preference memory (created by src/lib/memory/create-table.sh).
COVERED_MEMORY_TABLE=covered-memory
# Cloudflare creds are NOT here: ~/.config/covered/cloudflare.env (see README "Run / Deploy").
