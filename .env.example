# Copy to .env.local and fill in. Never commit real values.
AWS_REGION=eu-west-2
AWS_PROFILE=default
S3_BUCKET=covered-hack-616532055961
NEXT_PUBLIC_APP_NAME=Covered
# Bedrock judge (Decision+UI). Cross-region EU inference profile; leave empty for the default.
BEDROCK_MODEL_ID=
# Set to 1 to force the deterministic mock judge (no Bedrock calls).
COVERED_MOCK=
# Cloudflare creds are NOT here: ~/.config/covered/cloudflare.env (see README "Run / Deploy").
