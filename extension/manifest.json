{
  "manifest_version": 3,
  "name": "Covered reader",
  "version": "1.1.0",
  "description": "Reads the Google Shopping grid from your own signed-in browser session.",
  "browser_specific_settings": {
    "gecko": {
      "id": "covered-reader@kawuc.uk",
      "strict_min_version": "121.0"
    }
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://covered.kawuc.uk/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.uk/search*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://covered.kawuc.uk/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.co.uk/*",
    "https://*.gstatic.com/*",
    "https://encrypted-tbn0.gstatic.com/*",
    "https://encrypted-tbn1.gstatic.com/*",
    "https://encrypted-tbn2.gstatic.com/*",
    "https://encrypted-tbn3.gstatic.com/*",
    "https://covered.kawuc.uk/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "permissions": ["tabs"]
}
